    textSpeed: 0.05
    useGlitchEffect: 0
    glitchStartDelay: 0
    glitchDuration: 0
    glitchInterval: 0.1
    colorGlitchIntensity: 0.3
  - text: "\u4F1A\u3063\u305F\u3053\u3068\u306F\u306A\u3044\u3002\u6BCD\u304C\u9023\u7D61\u3092\u7D76\u3063\u3066\u3044\u305F\u304B\u3089\u3060\u3002"
