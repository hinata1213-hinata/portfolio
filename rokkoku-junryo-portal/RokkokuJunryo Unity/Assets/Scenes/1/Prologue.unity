    glitchDuration: 0
    glitchInterval: 0.1
    colorGlitchIntensity: 0.3
  - text: "\u7956\u6BCD\u306E\u6CD5\u8981\u306B\u51FA\u3066\u307B\u3057\u3044\u3068\u3001\u5F93\u59C9\u306E\u96EA\u97F3\uFF08\u3086\u304D\u306D\uFF09\u3055\u3093\u304B\u3089\u9023\u7D61\u304C\u3042\u3063\u305F\u3002"
