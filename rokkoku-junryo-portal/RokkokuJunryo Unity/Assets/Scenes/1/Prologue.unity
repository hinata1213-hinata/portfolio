  textLines:
  - text: "\u6BCD\u65B9\u306E\u7956\u6BCD\u3060\u3002\u516D\u523B\u6751\u3068\u3044\u3046\u5C71\u5965\u306E\u96C6\u843D\u306B\u4F4F\u3093\u3067\u3044\u305F\u3089\u3057\u3044\u3002"
