  - text: "\u6B63\u76F4\u3001\u8FF7\u3063\u305F\u3002\u4F1A\u3063\u305F\u3053\u3068\u3082\u306A\u3044\u7956\u6BCD\u306E\u305F\u3081\u306B\u3001\u308F\u3056\u308F\u3056\u5C71\u5965\u307E\u3067\u884C\u304F\u6C17\u306B\u306F\u306A\u308C\u306A\u304B\u3063\u305F\u3002"
